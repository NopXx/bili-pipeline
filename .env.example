# Copy to .env.local and fill in — .env.local is git-ignored and must never be committed.

# Google Drive OAuth (the app owns the uploaded files)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GOOGLE_REFRESH_TOKEN=
DRIVE_FOLDER_ID=

# Postgres — drive_push/drive_upload read the Drive refresh token from settings here
DATABASE_URL=

# Web control server (scripts/bili_web.py)
BILI_WEB_TOKEN=
BILI_WEB_HOST=127.0.0.1
BILI_WEB_PORT=8787

# Pipeline paths (optional overrides)
BILI_DOWNLOADS_DIR=/opt/bili-downloads
BILI_HLS_DIR=/opt/bili-hls
